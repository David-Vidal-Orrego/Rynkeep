DB_DATABASE=base_de_datos
DB_USERNAME=usuario
DB_PASSWORD=contraseña
DB_ROOT_PASSWORD=contraseña_root

# Carpeta donde se guardan los archivos de los usuarios. En un servidor, apunta al disco grande.
RYNKEEP_STORAGE_PATH=./almacenamiento  

# Tamaño máximo de un archivo subido, en MB.( Tras cambiarlo: docker compose up -d )
RYNKEEP_TAMANO_MAXIMO_MB=100
